    "AUTH_URL": "https://autoloop.blockbucket.workers.dev",
    "ADMIN_EMAIL": "shubhamjain.com.in@gmail.com",
    "FACEBOOK_CLIENT_ID": "25749953891364911",
    "GOOGLE_CLIENT_ID": "296823707624-ahlkqo55k0pn59ic41c25agd9hdisjnt.apps.googleusercontent.com",
    "TURSO_DATABASE_URL": "libsql://autoloop-shubhjn4357.aws-ap-south-1.turso.io",
    "META_GRAPH_VERSION": "v25.0",
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
