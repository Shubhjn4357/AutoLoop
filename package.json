{
  "name": "autoloop-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "turbo lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @autoloop/web test:unit",
    "test:components": "pnpm --filter @autoloop/web test:components",
    "test:e2e": "pnpm --filter @autoloop/web test:e2e",
    "check": "pnpm -r check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "doctor:ci": "pnpm --filter @autoloop/web doctor:ci",
    "env:push": "node scripts/push-hf-env.mjs",
    "docker:dev": "docker compose -f docker-compose.dev.yml up"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "turbo": "^2.9.10",
    "typescript": "^5"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "win32"
      ],
      "cpu": [
        "x64"
      ],
      "libc": [
        "glibc",
        "musl"
      ]
    }
  }
}
